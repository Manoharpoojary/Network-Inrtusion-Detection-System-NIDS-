# Copy to .env and adjust. All settings are optional; defaults are shown. No secrets are required.
# NIDS_MODEL_PATH=src/major_project/model/iot_intrusion_rf_pipeline (1).joblib
# Loading is refused if the artifact's SHA-256 differs from this value.
# NIDS_MODEL_SHA256=2557ad7b7b25f76f877f9048889d0de8b062672ea7743e380bcf3e5190173cde

# Flow is labelled Attack when P(attack) >= threshold (0.5 reproduces the reported metrics).
# NIDS_ATTACK_THRESHOLD=0.5
# Attack predictions with P(attack) >= this are "high" severity, otherwise "medium".
# NIDS_SEVERITY_HIGH_MIN_PROBABILITY=0.8

# NIDS_INFERENCE_N_JOBS=1
# NIDS_MAX_BATCH_RECORDS=1000
# NIDS_MAX_UPLOAD_BYTES=10485760
# NIDS_MAX_CSV_ROWS=50000
# NIDS_CSV_CHUNK_ROWS=1000

# auto | shap_tree | tree_path   (auto uses SHAP if the `explain` extra is installed)
# NIDS_EXPLANATION_METHOD=auto
# NIDS_EXPLANATION_TOP_K=8
# NIDS_MAX_EAGER_EXPLANATIONS=50

# Default: <project>/data/nids.db (git-ignored). PostgreSQL URLs also work with a driver installed.
# NIDS_DATABASE_URL=sqlite:///data/nids.db
# NIDS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keep false: live-flow features are not compatible with the model (docs/MODEL_CARD.md).
# NIDS_LIVE_INFERENCE_ENABLED=false
# NIDS_LOG_LEVEL=INFO
